# Copy to .env and fill in. Never commit .env.
META_DATASET_ID=your_dataset_id
META_ACCESS_TOKEN=your_conversions_api_access_token
# Optional: from Events Manager > Test events. Leave empty to send a real event.
META_TEST_EVENT_CODE=
# Use the current Graph API version listed in Meta's developer docs, e.g. v21.0
GRAPH_API_VERSION=
EVENT_SOURCE_URL=https://example.com/form
